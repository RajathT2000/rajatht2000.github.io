# Copy to .env (never commit .env). Used by server/server.js.
OPENAI_API_KEY=sk-your-key-here
# Tried in order until one works (comma-separated). Or set OPENAI_MODEL for a single model.
OPENAI_MODELS=gpt-5.4,gpt-5.2,gpt-5.1
PORT=3000
HOST=127.0.0.1
# 1 when running behind nginx (uses X-Real-IP for rate limiting)
TRUST_PROXY=1
# 0 when nginx serves the static files (recommended on the droplet)
SERVE_STATIC=0
# Abuse / cost guards
RATE_LIMIT=15
DAILY_CAP=500
