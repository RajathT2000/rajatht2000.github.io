# Copy to .env (never commit .env). Used by server/server.js.
OPENAI_API_KEY=sk-your-key-here
# Any chat model your key can use.
OPENAI_MODEL=gpt-4o-mini
PORT=3000
HOST=127.0.0.1
# 1 when running behind nginx (uses X-Real-IP for rate limiting)
TRUST_PROXY=1
# 0 when nginx serves the static files (recommended on the droplet)
SERVE_STATIC=0
# Abuse / cost guards
RATE_LIMIT=15
DAILY_CAP=500
